{
  "name": "janus-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome check src e2e playwright.config.ts vite.config.ts",
    "format": "biome check --write src e2e playwright.config.ts vite.config.ts",
    "generate:types": "openapi-typescript ../../generated/openapi.json -o src/generated/api.ts && biome check --write src/generated/api.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "cargo build --manifest-path ../../Cargo.toml -p janus-server -p janus-test && playwright test live-supervisor.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-query": "^5.85.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "lucide-solid": "^0.468.0",
    "marked": "^18.0.7",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.61.1",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-solid": "^2.11.8"
  }
}
