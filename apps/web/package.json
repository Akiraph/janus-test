{
  "name": "janus-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome check --write src",
    "generate:types": "openapi-typescript ../../generated/openapi.json -o src/generated/api.ts && biome check --write src/generated/api.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@solidjs/router": "^0.15.3",
    "@tanstack/solid-query": "^5.85.5",
    "lucide-solid": "^0.468.0",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.61.1",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-solid": "^2.11.8"
  }
}
