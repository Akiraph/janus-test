# =============================================================================
# Janus 部署环境变量模板
# 来源: README.md「Continuous integration」与「Configuration」章节
# 参考: .github/workflows/ci.yml（deploy-amd64）与 scripts/deploy_image.js
#
# 两部分:
#   [1] CI 部署密钥 —— 实际部署时填入 GitHub 仓库
#       Settings → Secrets and variables → Actions（同名 secret），
#       由 ci.yml 的 deploy-amd64 job 注入 scripts/deploy_image.js。
#   [2] janus-server 生产运行时变量 —— 容器需要设置的 JANUS_* 环境变量。
#
# 使用: 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，勿提交）。
# =============================================================================

# -----------------------------------------------------------------------------
# [1] CI 部署密钥（GitHub Actions Secrets；也供本地跑 scripts/deploy_image.js）
# -----------------------------------------------------------------------------

# 目标服务器地址；多台服务器用英文逗号分隔，与下方 USERNAME/PORT/PRIVATE_KEY/CONTAINER_NAMES 一一对应，组数必须一致。
SERVER_ADDRESS=203.0.113.10

# SSH 登录用户名。
USERNAME=root

# SSH 端口，默认 22。
PORT=22

# SSH 私钥（PEM 内容）。GitHub Secret 中直接粘贴完整的
#   -----BEGIN ... PRIVATE KEY-----
#   多行内容
#   -----END ... PRIVATE KEY-----
# 本地 .env 中换行须转义为 \n（或用双引号包裹整个值）。
PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----

# 容器名；多服务器用逗号分隔，同一服务器上多个容器用 & 连接。
#   例: CONTAINER_NAMES=janus,web&worker
#   含义: 服务器1 部署容器 janus；服务器2 部署 web 与 worker 两个容器。
CONTAINER_NAMES=janus

# 部署日志上传服务（https://tts.chloemlla.com/api/sharelog）的密码。
ADMIN_PASSWORD=change-me

# 镜像 URL 由 CI 自动计算。每次 push 会发布三个镜像（见 README「Continuous
# integration」）：combined 用 <short-sha>-combined-amd64，server 用 <short-sha>-server-amd64，
# web 用 <short-sha>-web-amd64。部署脚本默认拉 combined（前后端一体）。
# 本地手动跑脚本时才需要自己设置。
# IMAGE_URL=ghcr.io/your-owner/janus:xxxxxxxx-combined-amd64

# -----------------------------------------------------------------------------
# [2] janus-server 生产运行时变量（传给容器）
# -----------------------------------------------------------------------------

# 运行模式。生产环境必须为 production。
JANUS_MODE=production

# 对外 http(s) 来源；必须是无路径的绝对 http(s) 地址，且与公网主机名一致。
# passkey 生产部署必须 https；totp 部署（http/IP）可为 http —— http scheme 会自动
# 把会话 cookie 名降级为 janus_session 并去掉 Secure 属性（纯 http 下浏览器会拒收
# Secure cookie）。
JANUS_PUBLIC_ORIGIN=https://janus.example.com

# WebAuthn 依赖方 ID，默认取 public origin 的 host；建议显式设置。totp 模式下不使用。
JANUS_WEBAUTHN_RP_ID=janus.example.com

# 依赖方显示名（可选）。totp 模式下不使用。
JANUS_WEBAUTHN_RP_NAME=Janus

# 认证方式: passkey（默认，WebAuthn，要求 https 域名）或 totp（密钥 + 验证器 App，
# 用于 http / IP 部署）。
#   - http/IP 部署必须设为 totp：生产模式下 http origin + passkey 会让启动失败
#     （Config 校验抛 InsecureProductionOrigin）。
#   - 设为 totp 后初始化与登录改为输入 6 位 TOTP 验证码；WebAuthn 引擎不初始化，
#     上面的 JANUS_WEBAUTHN_RP_ID / JANUS_WEBAUTHN_RP_NAME 不再读取。
#   - 其余生产变量（JANUS_MODE=production、JANUS_MASTER_KEY、JANUS_MONGODB_URI 等）
#     与 https 部署完全一致，无 http 专属新增。
# JANUS_AUTH_MODE=passkey

# MongoDB replica set 连接串（多文档事务必需；必须是 mongodb:// 或 mongodb+srv://）。
JANUS_MONGODB_URI=mongodb://mongo.example.com:27017/?replicaSet=rs0

# Janus schema 所在数据库名。
JANUS_MONGODB_DATABASE=janus

# 主密钥：base64url（无填充），解码后恰好 32 字节，加密存储的 secrets 用。
# 生产环境必需，缺失则进程初始化失败。生成命令:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).rstrip(b'=').decode())"
# 已有部署请保留原密钥，否则已加密数据无法解密。
JANUS_MASTER_KEY=

# 数据根目录（数据库/工作区/Blob）。镜像默认 /data（volume）。
JANUS_DATA_ROOT=/data

# 监听地址。镜像默认 0.0.0.0:4317。
JANUS_BIND=0.0.0.0:4317

# 生产模式禁开开发态认证；保持 false。
JANUS_DEV_AUTH=false

# 内置 web 客户端目录。镜像默认 /app/web，同源托管 SPA。
JANUS_WEB_DIST=/app/web

# fork-sync webhook（默认关闭）。开启时必须同时设置 WEBHOOK_SECRET。
# JANUS_AUTOMATION_WEBHOOK_ENABLED=false
# JANUS_AUTOMATION_WEBHOOK_SECRET=
# 私库克隆 / gh 推送用的 classic PAT（可选）。
# JANUS_AUTOMATION_GITHUB_TOKEN=

# 日志过滤（默认 janus=info，JSON 输出）。
RUST_LOG=janus=info

# -----------------------------------------------------------------------------
# [3] 前端镜像（web target）/ Vercel 部署 —— JANUS_API_TARGET
# -----------------------------------------------------------------------------

# 前后端分离部署时，前端（nginx 镜像的 web target，或 Vercel）通过同源代理
# 把 /api、/health 转发到后端，浏览器始终只访问前端 origin，因此 SameSite=Strict
# 会话 cookie 与后端的 Origin 校验照常工作。后端侧 JANUS_PUBLIC_ORIGIN 必须设成
# 前端（nginx / Vercel）的公网地址。
#
#   - web 镜像（容器运行时 -e 传入，默认 http://127.0.0.1:4317）:
#       docker run ... -e JANUS_API_TARGET=http://janus-server:4317 -p 8080:80 janus-web
#   - Vercel（在 Vercel 项目 Settings → Environment Variables 里设置）:
#       JANUS_API_TARGET=https://janus.example.com
#
# Vercel 注意事项：外部 origin 的 rewrite/route 不转发 WebSocket 升级，所以终端
# 功能在 Vercel 部署上不可用；需要完整终端功能请使用 Docker 镜像部署。
JANUS_API_TARGET=http://127.0.0.1:4317
